{
  "expo": {
    "name": "AskUs Foundation",
    "slug": "askus-foundation-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "askus",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.askus.foundation.app",
      "infoPlist": {
        "NSCameraUsageDescription": "AskUs requires camera access to capture KYC documents and field impact photos during volunteer drives.",
        "NSPhotoLibraryUsageDescription": "AskUs requires photo library access to upload identity documents and emergency SOS evidence.",
        "NSLocationWhenInUseUsageDescription": "AskUs requires location access to verify physical attendance within drive geofence perimeters and locate SOS emergencies."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "org.askus.foundation.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@sentry/react-native/expo",
        {
          "organization": "askus-foundation",
          "project": "askus-mobile"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#16a34a",
          "sounds": [
            "./assets/sounds/urgent_sos.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AskUs requires location access to verify physical attendance within drive geofence perimeters."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AskUs requires camera access to document volunteer drive impact and capture KYC documents."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "askus-foundation-core-2026"
      }
    }
  }
}
